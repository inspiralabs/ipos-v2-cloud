# Dockerfile generik untuk Next.js apps di apps/* (admin-app, tenant-app).
# Build context = root ipos-cloud/ (sama seperti Dockerfile utama) supaya pnpm bisa
# resolve pnpm-workspace. Pilih app lewat build arg APP_NAME.
# NEXT_PUBLIC_API_URL di-inline saat build (bukan runtime) — wajib diisi build arg-nya.

FROM node:22-alpine AS base
RUN npm install -g pnpm@9
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/admin-app/package.json apps/admin-app/
COPY apps/tenant-app/package.json apps/tenant-app/
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
ARG APP_NAME
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
COPY . .
RUN pnpm --filter ${APP_NAME} build

FROM base AS runtime
ARG APP_NAME
ENV NODE_ENV=production
COPY --from=build /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=build /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
WORKDIR /app/apps/${APP_NAME}
CMD ["node", "server.js"]
