# Database (Supabase Transaction Pooler)
DATABASE_URL=postgresql://postgres.xxxx:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT RS256 — paste PEM content as single-line (replace newlines with \n)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# External services
RESEND_API_KEY=re_xxxx
RESEND_FROM=Inspira POS <noreply@inspiralabs.id>
FONNTE_TOKEN=xxxx
CLOUDFLARE_API_TOKEN=xxxx
CLOUDFLARE_ZONE_ID=xxxx

# RAHASIA! Untuk generate lisensi iPOS Offline
OFFLINE_LICENSE_SALT_LITE=GANTI_RANDOM_STRING_PANJANG
OFFLINE_LICENSE_SALT_PRO=GANTI_RANDOM_STRING_BERBEDA

# Dipakai admin-app & tenant-app saat build Docker (NEXT_PUBLIC_* di-inline saat build,
# bukan runtime) — isi domain nginx gateway di produksi, mis. https://api.inspirapos.biz.id
NEXT_PUBLIC_API_URL=http://localhost

# Service URLs (local dev)
AUTH_SERVICE_URL=http://localhost:3001
TENANT_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3009
REPORT_SERVICE_URL=http://localhost:3008

# Shared secret antar-service (bukan JWT user) — dipakai tenant-service memanggil
# notification-service. Sama nilainya di kedua service, wajib random & rahasia di produksi.
INTERNAL_API_KEY=GANTI_RANDOM_STRING_PANJANG

# Cloudflare R2 — upload foto menu (catalog-service) & logo toko (tenant-service).
# Access Key ID/Secret dari R2 > Manage R2 API Tokens (permission: Object Read & Write).
R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET_NAME=xxxx
R2_PUBLIC_URL=https://assets.inspirapos.biz.id
